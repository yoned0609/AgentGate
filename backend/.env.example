# AgentGate Configuration
# Copy this file to .env and update the values for your environment.

# Server
DEBUG=true
HOST=0.0.0.0
PORT=8100

# Google Calendar API (proxy target)
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3

# ⚠️  IMPORTANT: Change this key before deploying to production!
# This is a development-only default. Use a strong, unique secret in production.
MASTER_API_KEY=ag_dev_change_me_in_production

# Policy directory (relative to backend/)
POLICY_DIR=policies

# Audit log SQLite database path
AUDIT_DB_PATH=audit.db

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
